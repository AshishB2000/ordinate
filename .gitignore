# Phase 3c vendor bundle — the exceptions to "never commit .js".
# These two are NOT tsc output and have no .ts sibling:
#   scripts/build-vendor.js is a hand-written build tool (like download-geo.ts's
#   role, but plain Node — it must run before any TypeScript build exists), and
#   renderer/hub/vendor/vgplot.js is its committed output. Committing the bundle
#   is what keeps CI and electron-builder off the 180+ MB vgplot tree.
!/scripts/build-vendor.js
!/renderer/hub/vendor/vgplot.js

# scripts/build-icons.js — same exception, same reason: a hand-written build
# tool with no .ts sibling. It bakes assets/provider-icons.json so simple-icons
# can be a devDependency instead of 25 MB of runtime dependency.
!/scripts/build-icons.js

# Phase 3c Mosaic connector (mosaic:view / mosaic:query) — emitted siblings.
/src/ipc/mosaic.js
/scripts/test-mosaicIpc.js

# Phase 3c Mosaic/vgplot renderer — emitted siblings.
/renderer/hub/plotRender.js
/scripts/test-plotSpec.js
# Phase 4 MapLibre GL — emitted sibling.
/renderer/hub/mapWorker.js
/renderer/hub/lazyScript.js

# ── Phase 5: Svelte islands (docs/phase-5/01-toolchain.md) ──────────────────
# scripts/build-svelte.js is a hand-written build tool with no .ts sibling —
# same exception as build-vendor.js above, and for the same reason: it must run
# without a TypeScript build already existing.
!/scripts/build-svelte.js
# Its output. bundle.js is already covered by the `renderer/**/*.js` glob, but
# listed explicitly per the in-place-emit convention — and bundle.CSS needs its
# own entry, because until now this repo had no generated CSS and every .css
# file was hand-written source. Regenerate both with `npm run build:svelte`.
/renderer/hub/svelte/bundle.js
/renderer/hub/svelte/bundle.css

