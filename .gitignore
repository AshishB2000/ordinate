# Claude Code — personal, machine-specific overrides (never commit)
.claude/settings.local.json

# OS junk
.DS_Store

# Node / Electron
node_modules/

# Build output
dist/
out/
build/*
# …but DO track the code-signing entitlements (a source file, not build output).
!build/entitlements.mac.plist

# Local config / secrets (never commit API keys)
.env
config.json

# Claude Code agent worktrees (transient)
.claude/worktrees/

# Per-session agent state, NOT project source. These kept turning up STAGED
# after a worktree checkout — memory notes, and a brainstorm server's pids,
# tokens and scratch HTML — one `git commit -a` away from landing on develop.
# Note `.claude/plans/`, `.claude/skills/` and `.claude/settings.json` ARE
# tracked and deliberately stay that way; only the per-project session dir goes.
.claude/projects/
.superpowers/

# TypeScript: ALL runtime .js is compiled output of a sibling .ts source
# (in-place emit) — sources are the .ts files, never commit emitted .js.
/main.js
src/**/*.js
preload/**/*.js
renderer/**/*.js
scripts/**/*.js
!/scripts/build-appicon.js
