{
  // The server world: src/ modules and scripts/. NodeNext resolves + emits
  // CommonJS here (package.json has no "type": "module"), Node types, no DOM.
  // No outDir: each .ts emits its sibling .js in place.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    // Per-checkout cache — see tsconfig.base.json for why it is not in node_modules.
    "tsBuildInfoFile": ".tsbuildinfo/main.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  // The published site's renderer: classic browser scripts, compiled by tsconfig.site.json.
  "exclude": ["src/publish/site/**"]
}
