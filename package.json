{
  "name": "ordinate",
  "version": "0.1.0",
  "description": "Screenshot a chart or table, press a hotkey, get a plain-English explanation or an auto-drawn chart.",
  "main": "src/server/main.js",
  "author": "Screenchart",
  "homepage": "https://screenshot.app",
  "scripts": {
    "build:ts": "tsc -p tsconfig.main.json && tsc -p tsconfig.site.json && node scripts/check-emit.js --heal",
    "build": "npm run build:ts",
    "prestart": "npm run build",
    "start": "node src/server/main.js",
    "postinstall": "npm run build && node scripts/download-geo.js",
    "pretest": "npm run build",
    "test": "node --test --test-reporter=spec \"scripts/test-*.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"scripts/test-*.js\"",
    "lint": "oxlint --type-aware --tsconfig=tsconfig.main.json src scripts && oxlint --type-aware --tsconfig=tsconfig.site.json src/publish/site && oxlint --type-aware --tsconfig=web/tsconfig.json web/src web/public web/vite.config.ts && oxlint --type-aware --tsconfig=web/tsconfig.e2e.json web/e2e web/scripts/bundle-size.ts",
    "icons:verify": "node scripts/verify-icons.js",
    "bench:pipeline": "npm run build:ts && node scripts/bench-pipeline.js",
    "bench:prepare": "npm run build:ts && node scripts/bench-prepare.js",
    "bench:resident": "npm run build:ts && node scripts/bench-resident.js",
    "build:icons": "node scripts/build-icons.js",
    "server": "npm run build:ts && node src/server/main.js",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "test:web": "npm --prefix web test",
    "secrets:rotate": "node src/server/secrets/rotate.js",
    "import-desktop": "node src/server/importDesktop.js",
    "loadtest": "npm run build:ts && node scripts/loadtest.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "simple-icons": "^16.23.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.3",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "mysql2": "^3.23.2",
    "openid-client": "^6.8.8",
    "oracledb": "^7.0.1",
    "pg": "^8.22.0",
    "tedious": "^20.0.0",
    "zod": "^4.6.5"
  }
}
