{
  "name": "ordinate-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "size": "node scripts/bundle-size.ts",
    "e2e": "tsc --noEmit -p tsconfig.e2e.json && E2E_NO_BUILD=1 node --test --test-concurrency=1 --test-reporter=spec \"e2e/*.e2e.ts\""
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sgratzl/chartjs-chart-boxplot": "^4.4.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "chart.js": "^4.5.1",
    "chartjs-chart-financial": "^0.2.1",
    "chartjs-chart-matrix": "^3.0.4",
    "chartjs-chart-sankey": "^0.14.3",
    "chartjs-chart-treemap": "^3.1.0",
    "docx": "^9.8.1",
    "maplibre-gl": "4.7.1",
    "pdfmake": "^0.3.11",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
