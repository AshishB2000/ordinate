# Copy to deploy/.env and fill in. Compose reads it; nothing here is baked into the image.
# Passwords go into URLs (DATABASE_URL, the MinIO alias): use letters, digits, - and _ only
# (`openssl rand -hex 24` makes one).

# ── Required ───────────────────────────────────────────────────────────────────
# Wraps every stored connection password and AI key (32 bytes). Keep a copy: without it they are unreadable.
#   openssl rand -base64 32
ORDINATE_MASTER_KEY=
POSTGRES_PASSWORD=
MINIO_ROOT_USER=ordinate
MINIO_ROOT_PASSWORD=
# Made org admin at every sign-in — the first admin, and the way back in.
ORDINATE_ADMIN_EMAIL=admin@example.com

# ── Where Ordinate listens on this host ────────────────────────────────────────
# 127.0.0.1 keeps it reachable only from this machine (your proxy). Pick a free port.
ORDINATE_BIND=127.0.0.1
ORDINATE_PORT=8080

# ── Sign-in: header mode (default) ─────────────────────────────────────────────
# Ordinate believes X-Forwarded-Email only from TRUSTED_PROXY_CIDRS. Connections through the
# published port arrive from the compose network's gateway, so the default trusts exactly
# that — i.e. whatever runs on this host and connects to ORDINATE_BIND:ORDINATE_PORT. Run
# oauth2-proxy there in front of it, for example:
#   oauth2-proxy --provider=oidc --oidc-issuer-url=https://idp.example.com \
#     --client-id=… --client-secret=… --cookie-secret=… --email-domain=example.com \
#     --upstream=http://127.0.0.1:8080 --pass-user-headers=true --set-xauthrequest=true \
#     --http-address=0.0.0.0:4180 --redirect-url=https://ordinate.example.com/oauth2/callback
# (it sends X-Forwarded-Email upstream) and put TLS in front of oauth2-proxy.
# Never publish ORDINATE_BIND=0.0.0.0 in header mode: anyone reaching the port could claim any email.
AUTH_MODE=header
TRUSTED_PROXY_CIDRS=172.30.80.1/32
# The compose network; keep its .1 in TRUSTED_PROXY_CIDRS if you change it.
ORDINATE_SUBNET=172.30.80.0/24

# ── Switching to OIDC ──────────────────────────────────────────────────────────
# Ordinate signs people in with your IdP itself (Okta, Azure AD, Google, Keycloak). Register
# the redirect URL at the IdP, set these, and serve Ordinate over HTTPS (prod cookies are
# Secure): put a TLS proxy in front, then ORDINATE_BIND may be 0.0.0.0. New users join as
# viewers; ORDINATE_ADMIN_EMAIL is made admin.
#   AUTH_MODE=oidc
#   OIDC_ISSUER=https://idp.example.com/realms/acme
#   OIDC_CLIENT_ID=ordinate
#   OIDC_CLIENT_SECRET=
#   OIDC_REDIRECT_URL=https://ordinate.example.com/api/auth/callback
#   TRUSTED_PROXY_CIDRS=172.30.80.1/32   # still read: the TLS proxy's X-Forwarded-For names clients for rate limits
# Optional in either mode: only these email domains may sign in.
ALLOWED_EMAIL_DOMAINS=

# ── Optional ───────────────────────────────────────────────────────────────────
S3_BUCKET=ordinate
LOG_LEVEL=info
# A prebuilt image instead of building from this checkout.
# ORDINATE_IMAGE=ghcr.io/…/ordinate:<version>
