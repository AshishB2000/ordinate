{
  // Renderer world: sandboxed windows (hub/overlay/status/about/permission).
  // DOM lib, NO Node types. Renderer files are classic global-scope <script>s
  // sharing one scope — converted files must stay import/export-free so they
  // remain scripts, not modules. Shared cross-file globals live in
  // renderer/hub/globals.d.ts. No outDir: each .ts emits its sibling .js.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    // Legacy global-scope <script> layer, incrementally typed: noImplicitAny and
    // strictNullChecks are relaxed HERE ONLY so the DOM-heavy renderer compiles
    // without hundreds of noise casts. The main world (tsconfig.main.json) stays
    // fully strict. Tighten these back as renderer files get real types.
    "strict": false,
    "noImplicitThis": true,
    "alwaysStrict": true,
    // Per-checkout cache — see tsconfig.base.json for why it is not in node_modules.
    "tsBuildInfoFile": ".tsbuildinfo/renderer.tsbuildinfo"
  },
  "include": ["renderer/**/*.ts"],
  // Phase 5: the Svelte island sources are MODULES, bundled by esbuild
  // (scripts/build-svelte.js), not classic scripts emitted in place. Compiling
  // them here would emit stray sibling .js files, and their `import` statements
  // would poison the shared global-scope program every other renderer file
  // depends on. They are type-checked separately by tsconfig.svelte.json.
  "exclude": ["renderer/hub/svelte/**"]
}
